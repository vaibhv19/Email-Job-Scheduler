# ==============================================================================
# ReachInbox Full-Stack Email Job Scheduler — Environment Configuration Template
# ==============================================================================
# ENVIRONMENT-FILE PLACEMENT & SECURITY RULES:
#   1. ROOT SERVER ENVIRONMENT:
#      This full template is intended for the root '.env' file used by local server
#      processes. Note: Monorepo workspace environment loading is planned for Phase 1;
#      the repository currently contains templates only and does not yet execute
#      automatic environment injection.
#
#   2. SERVER PROCESSES (API & WORKER):
#      Local server processes (apps/api and apps/worker) are intended to share or inherit
#      configuration from the root '.env'. If discrete per-application server environment
#      files (apps/api/.env or apps/worker/.env) are configured in the monorepo tooling,
#      they must contain only the variables required by that specific server process
#      and must remain strictly uncommitted.
#
#   3. FRONTEND ENVIRONMENT (APPS/WEB) — CRITICAL ISOLATION RULE:
#      DO NOT copy this full template into 'apps/web/.env' or any frontend directory!
#      This file contains server-side secrets (database credentials, session secrets,
#      token encryption keys, SMTP passwords, Google client secrets, Slack secrets).
#      Any variables placed in the frontend application or prefixed with 'VITE_' are
#      statically bundled into public client-side JavaScript and exposed to all visitors.
#      When needed, the frontend must receive ONLY its own dedicated public variables
#      (such as VITE_API_URL) in an isolated frontend file (e.g., apps/web/.env.local).
#
#   4. GIT EXCLUSION:
#      Never commit real secrets or any '.env' / '.env.local' file to source control.
#
# Status Conventions:
#   [REQUIRED - CORE]        - Essential to run the core email scheduler locally
#                              (Server, PostgreSQL, Redis/BullMQ, Worker, SMTP, Sessions).
#   [REQUIRED - INTEGRATION] - Essential only when activating a specific integration
#                              (Google OAuth, Slack OAuth, Elasticsearch, Bull Board).
#   [OPTIONAL]               - Has sensible defaults or represents an alternative/fallback.
#
# Secret Generation:
#   Generate secure random strings for secrets using Node.js:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Production Security Checklist:
#   1. Set NODE_ENV=production.
#   2. Set COOKIE_SECURE=true (forces Secure flag on session cookies over HTTPS).
#   3. Update API_BASE_URL, FRONTEND_URL, and CORS_ORIGIN to production HTTPS domains.
#   4. Replace all placeholder values (replace_with_*, your_*) with strong secrets.
#   5. Register exact production callback URLs in Google Cloud and Slack App consoles.
#   6. For Oracle Cloud Always Free VM deployment, terminate HTTPS at reverse proxy;
#      use internal Docker network hostnames for DATABASE_URL and REDIS_URL;
#      and verify outbound SMTP egress (ports 587/465) in OCI VCN Security Lists.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER ENVIRONMENT
# ------------------------------------------------------------------------------
# [REQUIRED - CORE] Runtime environment ('development' | 'production' | 'test')
NODE_ENV=development

# [REQUIRED - CORE] API server listening port
PORT=3001

# [REQUIRED - CORE] Canonical API base URL (used for OAuth redirects, webhooks, and links)
API_BASE_URL=http://localhost:3001

# [REQUIRED - CORE] Web frontend client URL (used for CORS and OAuth completion redirects)
FRONTEND_URL=http://localhost:5173

# [REQUIRED - CORE] Allowed CORS origins (comma-separated if multiple origins allowed)
CORS_ORIGIN=http://localhost:5173

# [OPTIONAL] Application logging verbosity ('debug' | 'info' | 'warn' | 'error')
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. POSTGRESQL DATABASE CONFIGURATION (SOURCE OF TRUTH)
# ------------------------------------------------------------------------------
# Precedence & Canonical Approach:
#   DATABASE_URL is the canonical connection path used by the application and migration tooling.
#   If DATABASE_URL is defined, it takes precedence and individual DB_* parameters are ignored.
#   Individual DB_* parameters are provided as an optional alternative for environments where
#   discrete parameters are injected by cloud providers.
#
# [REQUIRED - CORE] Full PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reachinbox_scheduler

# [OPTIONAL] Discrete connection parameters (used only if DATABASE_URL is unset)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=reachinbox_scheduler
DB_USER=postgres
DB_PASSWORD=postgres

# [OPTIONAL] Connection pool maximum clients
DB_MAX_CONNECTIONS=20

# Test Isolation Note:
#   Automated tests (NODE_ENV=test) must connect to an isolated test database:
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reachinbox_test
#   Automated tests must NEVER run against or truncate 'reachinbox_scheduler'.

# ------------------------------------------------------------------------------
# 3. REDIS & BULLMQ CONFIGURATION (DELAYED QUEUE & COORDINATION)
# ------------------------------------------------------------------------------
# Precedence & Canonical Approach:
#   REDIS_URL is the canonical connection path used by BullMQ and distributed coordination locks.
#   If REDIS_URL is defined, it takes precedence and individual REDIS_* parameters are ignored.
#
# [REQUIRED - CORE] Canonical Redis connection URL
REDIS_URL=redis://localhost:6379

# [OPTIONAL] Discrete connection parameters (used only if REDIS_URL is unset)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# [OPTIONAL] Redis database index (0 is default for development)
REDIS_DB=0

# [OPTIONAL] Namespace prefix for BullMQ delayed queue keys
BULLMQ_PREFIX=reachinbox

# Test Isolation & Safety Warning:
#   Automated tests (NODE_ENV=test) must connect to an isolated database index (e.g., REDIS_DB=15
#   or REDIS_URL=redis://localhost:6379/15).
#   WARNING: A queue prefix (e.g. {test}:emails) namespaces keys but does NOT make FLUSHDB safe.
#   FLUSHDB wipes the entire database index. Never execute FLUSHDB on database 0 or against
#   shared instances. Test harnesses must use DB 15 and targeted key deletion (DEL reachinbox_test:*).

# ------------------------------------------------------------------------------
# 4. WORKER CONCURRENCY & DISTRIBUTED RATE LIMITS
# ------------------------------------------------------------------------------
# [REQUIRED - CORE] Maximum simultaneous jobs processed per worker process (RATE-01)
WORKER_CONCURRENCY=5

# [REQUIRED - CORE] Default minimum interval between sends for a sender in milliseconds (RATE-02)
# Overridden by sender-level min_send_interval_ms in PostgreSQL when specified.
DEFAULT_MIN_SEND_INTERVAL_MS=2000

# [REQUIRED - CORE] Default maximum emails allowed per sender per UTC hour window (RATE-04)
# Overridden by sender-level max_emails_per_hour in PostgreSQL when specified.
DEFAULT_MAX_EMAILS_PER_HOUR=50

# ------------------------------------------------------------------------------
# 5. ETHEREAL SMTP TEST DELIVERY CONFIGURATION
# ------------------------------------------------------------------------------
# Generate disposable test credentials at https://ethereal.email/create
# [REQUIRED - CORE] Ethereal SMTP server hostname
SMTP_HOST=smtp.ethereal.email

# [REQUIRED - CORE] SMTP port (587 for STARTTLS, 465 for SSL)
SMTP_PORT=587

# [REQUIRED - CORE] Whether to use TLS/SSL directly (false for port 587 STARTTLS)
SMTP_SECURE=false

# [REQUIRED - CORE] Ethereal account username
SMTP_USER=your_ethereal_user@ethereal.email

# [REQUIRED - CORE] Ethereal account password
SMTP_PASS=your_ethereal_password

# [REQUIRED - CORE] Default fallback sender email address (used if sender record lacks address)
SMTP_FROM_EMAIL=scheduler@example.com

# [REQUIRED - CORE] Default fallback sender display name
SMTP_FROM_NAME="ReachInbox Scheduler"

# ------------------------------------------------------------------------------
# 6. SESSION MANAGEMENT, CSRF & DATA SECURITY
# ------------------------------------------------------------------------------
# [REQUIRED - CORE] Secret key for signing/encrypting server-side session cookies (min 32 chars)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_a_secure_random_session_secret_32_chars_minimum

# [OPTIONAL] Name of the session cookie
SESSION_COOKIE_NAME=reachinbox_session

# [REQUIRED - CORE] Require HTTPS for session cookies (false in local HTTP dev; MUST be true in prod)
COOKIE_SECURE=false

# [OPTIONAL] SameSite attribute for session cookie ('lax' | 'strict' | 'none')
COOKIE_SAME_SITE=lax

# [REQUIRED - CORE] Secret key for generating and verifying anti-CSRF tokens
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CSRF_SECRET=replace_with_a_secure_random_csrf_secret_32_chars_minimum

# [REQUIRED - CORE] 32-byte (64 hex characters) encryption key for AES-256-GCM token encryption
# Used to encrypt sensitive OAuth access tokens at rest in PostgreSQL (slack_connections table).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=replace_with_a_secure_32_byte_hex_encryption_key_64_hex_chars

# ------------------------------------------------------------------------------
# 7. GOOGLE OAUTH 2.0 CONFIGURATION
# ------------------------------------------------------------------------------
# Provider Console Setup:
#   Create credentials at https://console.cloud.google.com/apis/credentials
#   Under 'Authorized redirect URIs', add this EXACT URL:
#     http://localhost:3001/api/auth/google/callback
#   Any mismatch (including trailing slash or port) causes 'redirect_uri_mismatch' errors.
#
# [REQUIRED - INTEGRATION] Google OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# [REQUIRED - INTEGRATION] Google OAuth 2.0 Client Secret
GOOGLE_CLIENT_SECRET=your_google_client_secret

# [REQUIRED - INTEGRATION] OAuth callback URL matching Google Cloud Console exactly
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# ------------------------------------------------------------------------------
# 8. SLACK OAUTH & NOTIFICATION CONFIGURATION
# ------------------------------------------------------------------------------
# Provider Console Setup:
#   Create an app at https://api.slack.com/apps
#   Under 'OAuth & Permissions > Redirect URLs', add this EXACT URL:
#     http://localhost:3001/api/slack/callback
#   Required Bot Scopes: chat:write, channels:read, incoming-webhook
#
# Per-User / Per-Tenant Connection Model:
#   After OAuth authorization, individual access tokens, target team IDs, and channel IDs
#   are stored encrypted in the PostgreSQL 'slack_connections' table per user/tenant.
#   They are NOT global environment variables.
#
# [REQUIRED - INTEGRATION] Slack App Client ID (used for OAuth code exchange)
SLACK_CLIENT_ID=your_slack_client_id

# [REQUIRED - INTEGRATION] Slack App Client Secret (used for OAuth code exchange)
SLACK_CLIENT_SECRET=your_slack_client_secret

# [REQUIRED - INTEGRATION] Canonical OAuth callback URL matching Slack App settings exactly
SLACK_CALLBACK_URL=http://localhost:3001/api/slack/callback

# [REQUIRED - INTEGRATION] Slack Signing Secret (used to verify HMAC SHA-256 signatures on incoming webhooks/interactions)
SLACK_SIGNING_SECRET=your_slack_signing_secret

# [OPTIONAL] Fallback Slack channel name/ID for quota alerts if not chosen during OAuth
SLACK_NOTIFICATION_CHANNEL=#rate-limit-alerts

# ------------------------------------------------------------------------------
# 9. ELASTICSEARCH CONFIGURATION (SEARCH & INDEXING)
# ------------------------------------------------------------------------------
# Local Docker Configuration:
#   In local Docker Compose (infra/docker-compose.yml), Elasticsearch runs in single-node
#   mode with 'xpack.security.enabled=false' to minimize developer friction.
#   Authentication credentials are NOT required for local Docker development.
#   Only configure USERNAME and PASSWORD when connecting to a secured or cloud cluster.
#
# [REQUIRED - INTEGRATION] Elasticsearch cluster node endpoint
ELASTICSEARCH_NODE=http://localhost:9200

# [REQUIRED - INTEGRATION] Primary search index name
ELASTICSEARCH_INDEX=emails

# [OPTIONAL] Basic auth username (leave blank for local Docker with security disabled)
ELASTICSEARCH_USERNAME=

# [OPTIONAL] Basic auth password (leave blank for local Docker with security disabled)
ELASTICSEARCH_PASSWORD=

# ------------------------------------------------------------------------------
# 10. BULL BOARD QUEUE DASHBOARD
# ------------------------------------------------------------------------------
# [REQUIRED - INTEGRATION] Protected route mount path for Bull Board UI (OPS-01)
BULL_BOARD_PATH=/admin/queues

# [REQUIRED - INTEGRATION] HTTP Basic Auth username for Bull Board access (OPS-03)
BULL_BOARD_USERNAME=admin

# [REQUIRED - INTEGRATION] HTTP Basic Auth password for Bull Board access (OPS-03)
BULL_BOARD_PASSWORD=replace_with_secure_bull_board_admin_password

# ------------------------------------------------------------------------------
# 11. FRONTEND PUBLIC ENVIRONMENT VARIABLES (VITE)
# ------------------------------------------------------------------------------
# ==============================================================================
# CRITICAL SECURITY WARNING FOR VITE_* VARIABLES:
# Variables prefixed with VITE_ are statically compiled into the client-side
# JavaScript bundle and made PUBLICLY VISIBLE to every browser user.
#
# NEVER put database credentials, session secrets, token encryption keys,
# SMTP passwords, Google client secrets, Slack secrets, or any other server-side
# private credentials into VITE_* variables.
# ==============================================================================
# [REQUIRED - CORE] Backend API URL for frontend HTTP requests
VITE_API_URL=http://localhost:3001/api
