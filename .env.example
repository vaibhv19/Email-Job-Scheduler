# ==============================================================================
# ReachInbox Full-Stack Email Job Scheduler — Environment Configuration Template
# ==============================================================================
# Copy this file to .env (or apps/api/.env, apps/worker/.env, apps/web/.env)
# Fill in real values for local development. Never commit real secrets to Git.
#
# Status convention:
#   [REQUIRED] - Essential for core local operation.
#   [OPTIONAL] - Has defaults or only required for specific integrations.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER ENVIRONMENT
# ------------------------------------------------------------------------------
# [REQUIRED] Runtime environment ('development' | 'production' | 'test')
NODE_ENV=development

# [REQUIRED] API server port
PORT=3001

# [REQUIRED] Canonical API base URL (used for OAuth redirects and links)
API_BASE_URL=http://localhost:3001

# [REQUIRED] Web frontend URL (used for CORS and OAuth redirects)
FRONTEND_URL=http://localhost:5173

# [REQUIRED] Allowed CORS origins (comma-separated if multiple)
CORS_ORIGIN=http://localhost:5173

# [OPTIONAL] Application log level ('debug' | 'info' | 'warn' | 'error')
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. POSTGRESQL DATABASE CONFIGURATION (SOURCE OF TRUTH)
# ------------------------------------------------------------------------------
# [REQUIRED] Full PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reachinbox_scheduler

# [OPTIONAL] Individual parameters (if connecting without DATABASE_URL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=reachinbox_scheduler
DB_USER=postgres
DB_PASSWORD=postgres
DB_MAX_CONNECTIONS=20

# ------------------------------------------------------------------------------
# 3. REDIS & BULLMQ CONFIGURATION (DELAYED JOBS & RATE LIMITING)
# ------------------------------------------------------------------------------
# [REQUIRED] Redis connection URL
REDIS_URL=redis://localhost:6379

# [OPTIONAL] Individual Redis parameters
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ------------------------------------------------------------------------------
# 4. WORKER CONCURRENCY & RATE-LIMIT OPERATIONAL SETTINGS
# ------------------------------------------------------------------------------
# [REQUIRED] Maximum simultaneous jobs processed per worker process
WORKER_CONCURRENCY=5

# [REQUIRED] Default minimum interval between sends for a sender (in milliseconds)
DEFAULT_MIN_SEND_INTERVAL_MS=2000

# [REQUIRED] Default maximum emails allowed per sender per UTC hour
DEFAULT_MAX_EMAILS_PER_HOUR=50

# ------------------------------------------------------------------------------
# 5. ETHEREAL SMTP TEST DELIVERY CONFIGURATION
# ------------------------------------------------------------------------------
# Generate test credentials at https://ethereal.email/create
# [REQUIRED] Ethereal SMTP server hostname
SMTP_HOST=smtp.ethereal.email

# [REQUIRED] SMTP port (587 for STARTTLS, 465 for SSL)
SMTP_PORT=587

# [REQUIRED] Whether to use TLS/SSL directly (false for port 587)
SMTP_SECURE=false

# [REQUIRED] Ethereal account username
SMTP_USER=your_ethereal_user@ethereal.email

# [REQUIRED] Ethereal account password
SMTP_PASS=your_ethereal_password

# [REQUIRED] Default fallback sender email address
SMTP_FROM_EMAIL=scheduler@example.com

# [REQUIRED] Default fallback sender display name
SMTP_FROM_NAME="ReachInbox Scheduler"

# ------------------------------------------------------------------------------
# 6. SESSION MANAGEMENT & SECURITY (SERVER-SIDE SESSIONS PER ARCHITECTURE)
# ------------------------------------------------------------------------------
# [REQUIRED] Secret key for signing/encrypting session cookies (min 32 random chars)
SESSION_SECRET=replace_with_a_secure_random_session_secret_32_chars_minimum

# [REQUIRED] Session cookie name
SESSION_COOKIE_NAME=reachinbox_session

# [REQUIRED] Whether cookies require HTTPS (set to true in production)
COOKIE_SECURE=false

# ------------------------------------------------------------------------------
# 7. GOOGLE OAUTH 2.0 CONFIGURATION
# ------------------------------------------------------------------------------
# Create OAuth 2.0 Client Credentials in Google Cloud Console
# Authorized redirect URI: http://localhost:3001/api/auth/google/callback
# [REQUIRED for Google Login] Google Client ID
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# [REQUIRED for Google Login] Google Client Secret
GOOGLE_CLIENT_SECRET=your_google_client_secret

# [REQUIRED for Google Login] Redirect URI matching Google Cloud Console
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# ------------------------------------------------------------------------------
# 8. SLACK OAUTH & NOTIFICATION CONFIGURATION
# ------------------------------------------------------------------------------
# Create a Slack App at https://api.slack.com/apps
# Scopes required: chat:write, channels:read, incoming-webhook
# Authorized redirect URI: http://localhost:3001/api/slack/callback
# [REQUIRED for Slack Integration] Slack Client ID
SLACK_CLIENT_ID=your_slack_client_id

# [REQUIRED for Slack Integration] Slack Client Secret
SLACK_CLIENT_SECRET=your_slack_client_secret

# [REQUIRED for Slack Integration] Slack Signing Secret (for webhook validation)
SLACK_SIGNING_SECRET=your_slack_signing_secret

# [REQUIRED for Slack Integration] Redirect URI matching Slack App configuration
SLACK_CALLBACK_URL=http://localhost:3001/api/slack/callback

# [OPTIONAL] Fallback Slack channel name/ID for quota alerts
SLACK_NOTIFICATION_CHANNEL=#rate-limit-alerts

# ------------------------------------------------------------------------------
# 9. ELASTICSEARCH CONFIGURATION (SEARCH & INDEXING)
# ------------------------------------------------------------------------------
# [REQUIRED] Elasticsearch cluster node endpoint
ELASTICSEARCH_NODE=http://localhost:9200

# [REQUIRED] Primary search index name
ELASTICSEARCH_INDEX=emails

# [OPTIONAL] Elasticsearch authentication credentials (if security enabled)
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=changeme

# ------------------------------------------------------------------------------
# 10. BULL BOARD QUEUE DASHBOARD
# ------------------------------------------------------------------------------
# [REQUIRED] Protected route mount path for Bull Board UI
BULL_BOARD_PATH=/admin/queues

# [REQUIRED] HTTP Basic Auth username for Bull Board access
BULL_BOARD_USERNAME=admin

# [REQUIRED] HTTP Basic Auth password for Bull Board access
BULL_BOARD_PASSWORD=replace_with_secure_bull_board_admin_password

# ------------------------------------------------------------------------------
# 11. FRONTEND PUBLIC ENVIRONMENT VARIABLES (VITE)
# ------------------------------------------------------------------------------
# Notice: Only variables prefixed with VITE_ are exposed to the browser bundle.
# Never expose server-side secrets, database credentials, or private API keys here.
# [REQUIRED] Backend API URL for frontend HTTP requests
VITE_API_URL=http://localhost:3001/api
